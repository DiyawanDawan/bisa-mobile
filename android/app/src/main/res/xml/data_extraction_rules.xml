<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-MOB-016: cloud + device transfer backup di-disable.
  SharedPreferences & local files (KTP cache, tokens) tidak boleh di-backup.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database"/>
    <exclude domain="file"/>
    <exclude domain="root"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database"/>
    <exclude domain="file"/>
    <exclude domain="root"/>
  </device-transfer>
</data-extraction-rules>
