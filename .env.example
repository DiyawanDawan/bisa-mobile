# BISA Mobile — environment example.
# Copy ke `.env` lalu isi sesuai environment (dev / staging / prod).
#
# Penting:
# - HANYA value yang aman ter-bundle ke APK boleh ada di sini.
# - JANGAN pernah taruh server-side secret (PUSHER_SECRET, XENDIT secret, dll.)
# - Untuk multi-env, gunakan `--dart-define` saat `flutter build` daripada `.env`.

# API endpoint backend BISA. WAJIB HTTPS di production.
API_URL=https://api.example.com/api/v1

# Origin untuk URL gambar (tanpa /api/v1). Kosongkan = derive dari API_URL.
MEDIA_BASE_URL=

# Pusher Channels — HANYA public credentials.
# Dapatkan dari Pusher dashboard → App Keys.
PUSHER_KEY=your_pusher_app_key
PUSHER_CLUSTER=ap1
