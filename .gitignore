# Environment variables (SEC-MOB-003)
# Never commit .env — file ter-bundle ke APK sebagai asset.
.env
.env.local
.env.*.local
!.env.example

# Release signing (SEC-MOB-007) — store keystore di luar repo / CI secrets
/android/key.properties
*.jks
*.keystore

# Local dev API keys / ngrok (gunakan dart_define.example.json sebagai template)
dart_define.dev.json
dart_define.*.json
!dart_define.example.json

# Cursor: skills, rules, hooks (workspace lokal)
.cursor/

# Planning & integration audit/task docs (Palning Interasi)
Palning Interasi/
Palning%20Interasi/
**/Palning*/
